{
  "name": "cena",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted recipe manager: import, organize, rate and cook recipes.",
  "license": "MIT",
  "type": "module",
  "module": "src/backend/main.ts",
  "scripts": {
    "build": "bun run src/scripts/build.ts",
    "build:ingredient-parser": "bun run src/scripts/build-ingredient-parser.ts",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "hash-password": "bun run src/scripts/hash-password.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "migrate": "bun run src/scripts/migrate.ts",
    "screenshots": "bun run src/scripts/screenshots.ts",
    "seed": "bun run src/scripts/seed.ts",
    "start": "bun run src/backend/main.ts",
    "start:dev": "CENA_DEV=1 bun --watch src/backend/main.ts",
    "test": "bun test --parallel",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@knadh/oat": "1.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "peggy": "5.1.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.4"
  }
}
