        "fmt:check": "bun fmt --check",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@needle-di/core": "~0.8.4",
        "classnames": "~2.5.1",
        "preact": "~10.24.3",
        "preact-render-to-string": "~6.5.11"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "bootstrap-icons": "~1.8.3",
        "oxlint": "^1.89.0",
        "peggy": "^5.1.1",
        "sass": "^1.106.1",
        "schema-dts": "~1.1.2",
        "terser": "^5.51.2",
        "typescript": "^7.0.2"
    }
}
