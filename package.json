{
    "name": "prandium",
    "private": true,
    "type": "module",
    "engines": {
        "bun": ">=1.4.4"
    },
    "scripts": {
        "test": "bun test tests/data tests/controllers tests/tpl tests/shared tests/logging.test.ts tests/options.test.ts",
        "test:coverage": "bun run test --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=out/coverage",
